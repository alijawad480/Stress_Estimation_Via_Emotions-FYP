# ── Copy to .env and update ML_FRAMEWORK_PATH ───────────────────────────────

# Path to your ML framework folder (the stress_framework folder from Drive)
ML_FRAMEWORK_PATH=C:/Users/YourName/stress_framework

# Model selection (LMF/cross_modal = best RMSE)
MODEL_NAME=LMF
MODEL_FUSION=cross_modal

# Flask settings
SECRET_KEY=stress-detect-secret-key-2024
PORT=5000
DEBUG=true
